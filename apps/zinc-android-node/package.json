{
  "name": "@zinc-project/zinc-android-node",
  "version": "0.0.1",
  "description": "Backend hosted by Zinc's embedded Node runtime on Android",
  "private": true,
  "nx": {
    "tags": [
      "type:server",
      "scope:node"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/apps/zinc-android/android/app/src/main/assets/nodejs"
        ],
        "options": {
          "command": "node scripts/build.mjs",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@zinc-project/backend": "*",
    "@zinc-project/contracts": "*",
    "@zinc-project/data": "*",
    "better-sqlite3": "^13.0.3",
    "rxjs": "~7.8.2",
    "rxjs-bridge": "^0.8.0",
    "ws": "^8.22.0"
  }
}
