{
  "name": "@zinc-project/zinc-server-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "implicitDependencies": [
      "@zinc-project/zinc-server"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/vitest:test",
        "outputs": [
          "{projectRoot}/test-output/vitest"
        ],
        "options": {
          "configFile": "apps/zinc-server-e2e/vitest.e2e.config.mts"
        },
        "dependsOn": [
          "@zinc-project/zinc-server:build"
        ]
      }
    },
    "tags": [
      "type:e2e",
      "scope:node"
    ]
  }
}
