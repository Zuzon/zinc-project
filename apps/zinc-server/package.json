{
  "name": "@zinc-project/zinc-server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "outputPath": "apps/zinc-server/dist",
          "main": "apps/zinc-server/src/main.ts",
          "tsConfig": "apps/zinc-server/tsconfig.app.json",
          "assets": [
            "apps/zinc-server/src/assets"
          ],
          "swcrc": "apps/zinc-server/.swcrc"
        },
        "configurations": {
          "development": {},
          "production": {}
        },
        "dependsOn": [
          "^build"
        ]
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/zinc-server/dist/package.json",
          "{workspaceRoot}/apps/zinc-server/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/zinc-server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@zinc-project/zinc-server:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@zinc-project/zinc-server:build:development"
          },
          "production": {
            "buildTarget": "@zinc-project/zinc-server:build:production"
          }
        }
      }
    },
    "tags": [
      "type:server",
      "scope:node"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "~6.0.3",
    "@fastify/sensible": "~6.0.2",
    "@fastify/static": "10.1.4",
    "@zinc-project/backend": "*",
    "@zinc-project/contracts": "*",
    "@zinc-project/data": "*",
    "fastify": "~5.2.1",
    "fastify-plugin": "~5.0.1",
    "rxjs": "~7.8.2",
    "rxjs-bridge": "^0.8.0",
    "ws": "^8.22.0"
  }
}
