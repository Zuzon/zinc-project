{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve browser-shell",
      "type": "shell",
      "command": "npx nx serve @zinc-project/browser-shell",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeAtBeginning": true,
          "beginsPattern": "nx run @zinc-project/browser-shell:serve",
          "endsPattern": "Local:\\s+http"
        }
      }
    }
  ]
}
