{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug @zinc-project/zinc-server with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "@zinc-project/zinc-server"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/zinc-server/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug browser-shell in Chrome",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/browser-shell",
      "pathMapping": {
        "/@fs/": "/"
      },
      "preLaunchTask": "serve browser-shell"
    }
  ]
}
